# =============================
# Global .gitignore for ecomerce-arte
# =============================

# -------------------------------------------------
# Dependencias (Node.js / pnpm)
# -------------------------------------------------
# Ignorar cualquier carpeta node_modules en cualquier nivel
**/node_modules/
# Mantener el lockfile para reproducibilidad
!pnpm-lock.yaml

# -------------------------------------------------
# Compilación y artefactos de construcción
# -------------------------------------------------
# Next.js build output
**/.next/
# Distribución de backend (si usa dist o build)
**/dist/
**/build/
# Turbo (turborepo) cache
**/.turbo/
# Cobertura de tests
coverage/

# -------------------------------------------------
# Seguridad – archivos sensibles
# -------------------------------------------------
# Variables de entorno
*.env
*.env.*
# Excepciones: mantener ejemplos de env para referencia
!.env.example
# Certificados y llaves privadas
*.pem
*.key
*.crt
*.pfx
*.cer

# -------------------------------------------------
# Entorno local (Windows / editores)
# -------------------------------------------------
# VS Code workspace settings
.vscode/
# Archivos del sistema operativo
Thumbs.db
.DS_Store
# Logs de npm/pnpm
npm-debug.log*
pnpm-debug.log*

# -------------------------------------------------
# Otros archivos que no deben versionarse
# -------------------------------------------------
# Archivos temporales de editor
*~
*.swp

# Fin del archivo .gitignore
