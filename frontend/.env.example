# =============================================================================
# FRONTEND ENVIRONMENT — EXAMPLE CONFIGURATION
# =============================================================================

# URL base de la API del backend (Next.js 15 corriendo en puerto 4000)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# URL pública del frontend (usada por el backend para generar links de verificación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# LLAVES PÚBLICAS REQUERIDAS EN EL CLIENTE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
