# =============================================================================
# PNPM CONFIGURATION - Art E-Commerce Platform
# Supply-chain security: forces use of pnpm, blocks npm/yarn
# =============================================================================

# Block npm/yarn usage - only pnpm is allowed
engine-strict=true

# Prevent automatic install of peer dependencies (explicit control)
auto-install-peers=false

# Ensure lockfile is always up to date (CI safety)
frozen-lockfile=false

# Disable running lifecycle scripts from dependencies by default
# (must be explicitly enabled per-package if needed)
ignore-scripts=true

# Store location for pnpm cache
store-dir=~/.pnpm-store

# Security: reject unauthorized SSL certificates
strict-ssl=true

# Prefer offline when packages are cached
prefer-frozen-lockfile=true
